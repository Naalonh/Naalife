# Copy to .dev.vars (git-ignored). Used only by `wrangler dev`.
ENVIRONMENT=development
# Browser-testing login without Telegram. Honoured ONLY when ENVIRONMENT=development
# AND the request host is localhost / 127.0.0.1. Never set this in production.
DEV_AUTH_ENABLED=true

TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_WEBHOOK_SECRET=replace-with-long-random-string
OWNER_TELEGRAM_ID=123456789
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
APP_URL=http://localhost:5173
API_URL=http://localhost:8787
