# ---------------------------------------------------------------------------
# Reference list of every variable the project uses. Real values are NOT stored
# in a root .env file:
#   * Worker (local)      -> apps/worker/.dev.vars        (git-ignored, see .dev.vars.example)
#   * Worker (production) -> `wrangler secret put <NAME>` / [vars] in wrangler.jsonc
#   * Web (build time)    -> apps/web/.env  (public values only; see apps/web/.env.example)
# ---------------------------------------------------------------------------

# --- Secrets (Cloudflare Secrets in production) ---
TELEGRAM_BOT_TOKEN=          # from @BotFather
TELEGRAM_WEBHOOK_SECRET=     # random string you invent: openssl rand -hex 32
OWNER_TELEGRAM_ID=           # your numeric Telegram user id (ask @userinfobot)
SUPABASE_URL=                # https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=         # Supabase "secret" key (sb_secret_...) or legacy service_role key. Server only!

# --- Plain configuration (wrangler.jsonc [vars]) ---
APP_URL=                     # https URL of the deployed Mini App (also the only allowed CORS origin)
API_URL=                     # https URL of the deployed Worker
ENVIRONMENT=production       # "development" only in apps/worker/.dev.vars

# --- Optional ---
SESSION_SECRET=              # dedicated session-signing secret; defaults to a key derived from the bot token

# --- Local development only (apps/worker/.dev.vars; never set in production) ---
DEV_AUTH_ENABLED=false       # true enables POST /api/auth/dev, and only with ENVIRONMENT=development on localhost

# --- Web (apps/web/.env, public) ---
VITE_API_URL=                # empty in dev (Vite proxies /api); Worker URL in production builds
